# Copy this file to .env and change the passcode.

# Needed to delete pins. Pick something only the leaders know.
ADMIN_PASSCODE=change-me

# The port the app is served on (http://localhost:8080).
PORT=8080

# Optional: lock adding JIDs. With SUBMIT_LOCK=on, a device must be unlocked once with
# SUBMIT_PASSCODE before it can add JIDs, so other people on the same network can't.
# Looking at the globe and stats stays open to everyone.
SUBMIT_LOCK=off
SUBMIT_PASSCODE=change-me-too

# Optional: the example JID shown greyed out in the empty JID box. Defaults to 5GB123TXA.
# JID_PLACEHOLDER=5GB123TXA
